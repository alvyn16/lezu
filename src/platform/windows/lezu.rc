#include <windows.h>

IDI_ICON1 ICON DISCARDABLE "resources/icons/lezu.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Lezu Project"
            VALUE "FileDescription",  "Lezu Game Library Manager"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "lezu"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Lezu Contributors"
            VALUE "OriginalFilename", "lezu.exe"
            VALUE "ProductName",      "Lezu"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
