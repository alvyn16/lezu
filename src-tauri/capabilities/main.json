{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local main window can access the game library and selected folders.",
  "windows": ["main"],
  "permissions": [
    "allow-runtime-info",
    "allow-list-library",
    "allow-add-manual-game",
    "allow-launch-installation",
    "allow-reveal-installation",
    "allow-scan-folder-preview",
    "allow-cancel-scan",
    "allow-discover-stores",
    "allow-import-store-games",
    "allow-refresh-artwork",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart"
  ]
}
