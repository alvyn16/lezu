{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local main window can access the game library and selected folders.",
  "windows": ["main"],
  "permissions": [
    "allow-runtime-info",
    "allow-list-library",
    "allow-add-manual-game",
    "allow-launch-installation",
    "allow-reveal-installation",
    "allow-scan-folder-preview",
    "allow-cancel-scan",
    "allow-discover-stores",
    "allow-import-store-games",
    "allow-refresh-artwork",
    "allow-epic-connect",
    "allow-epic-sync",
    "allow-epic-disconnect",
    "allow-epic-install",
    "allow-epic-cancel-download",
    "allow-epic-launch",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://legendary.gl/epiclogin" }]
    }
  ]
}
