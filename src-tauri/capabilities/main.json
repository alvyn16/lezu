{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local main window can access the game library and selected folders.",
  "windows": ["main"],
  "permissions": [
    "allow-runtime-info",
    "allow-list-library",
    "allow-get-featured-game",
    "allow-set-featured-game",
    "allow-get-library-artwork",
    "allow-list-downloads",
    "allow-begin-download",
    "allow-set-download-progress",
    "allow-finish-download",
    "allow-clear-download-history",
    "allow-get-install-location",
    "allow-set-install-location",
    "allow-add-manual-game",
    "allow-launch-installation",
    "allow-reveal-installation",
    "allow-scan-folder-preview",
    "allow-cancel-scan",
    "allow-discover-stores",
    "allow-import-store-games",
    "allow-refresh-artwork",
    "allow-steamgriddb-key-status",
    "allow-set-steamgriddb-key",
    "allow-epic-connect",
    "allow-epic-sync",
    "allow-epic-disconnect",
    "allow-epic-install",
    "allow-epic-uninstall",
    "allow-epic-cancel-download",
    "allow-epic-launch",
    "allow-gog-connect",
    "allow-gog-sync",
    "allow-gog-disconnect",
    "allow-gog-install",
    "allow-gog-uninstall",
    "allow-gog-cancel-download",
    "allow-gog-launch",
    "allow-steam-connect",
    "allow-steam-cancel",
    "allow-steam-sync",
    "allow-steam-disconnect",
    "allow-steam-install",
    "allow-steam-uninstall",
    "allow-steam-launch",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://legendary.gl/epiclogin" }, { "url": "https://auth.gog.com/auth?*" }]
    }
  ]
}
